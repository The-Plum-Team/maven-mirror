{
  "comment": "Reviewed redistribution policy. A component is mirrored only when an 'include' rule matches its group and module name and no 'exclude' rule does. Anything that matches no rule is not mirrored. Changing this file is a license decision: cite the upstream's own license file in 'evidence'.",
  "upstreams": {
    "fabric": "https://maven.fabricmc.net/",
    "architectury": "https://maven.architectury.dev/",
    "kikugie": "https://maven.kikugie.dev/releases/",
    "neoforged": "https://maven.neoforged.net/releases/",
    "forge": "https://maven.minecraftforge.net/",
    "geckolib": "https://dl.cloudsmith.io/public/geckolib3/geckolib/maven/"
  },
  "exclude": [
    {
      "group": "^com[.]mojang([.].*)?$",
      "module": ".*",
      "reason": "Mojang libraries. Never mirrored, whatever their individual license."
    },
    {
      "group": "^net[.]minecraft([.].*)?$",
      "module": ".*",
      "reason": "Minecraft itself. Never mirrored."
    },
    {
      "group": "^org[.]lwjgl$",
      "module": "^lwjgl-freetype$",
      "reason": "Mojang-patched native served only by libraries.minecraft.net."
    },
    {
      "group": "^de[.]oceanlabs[.]mcp$",
      "module": ".*",
      "reason": "MCPConfig/MCInjector: decompilation data derived from Minecraft, and MCInjector has no clear license. Unclear, so excluded."
    },
    {
      "group": "^net[.]neoforged$",
      "module": "^neoform$",
      "reason": "NeoForm: decompilation data derived from Minecraft; the neoforged/NeoForm repository has no license file. Unclear, so excluded."
    },
    {
      "group": "^net[.]fabricmc$",
      "module": "^fabric-log4j-util$",
      "reason": "No public source repository or license statement found. Unclear, so excluded until verified."
    },
    {
      "group": "^com[.]eliotlash[.]mclib$",
      "module": ".*",
      "reason": "mclib: neither the POM nor mchorse/mclib states a license. Unclear, so excluded."
    }
  ],
  "include": [
    {
      "group": "^net[.]fabricmc$",
      "module": "^fabric-loader$",
      "license": "Apache-2.0",
      "evidence": "https://github.com/FabricMC/fabric-loader/blob/master/LICENSE",
      "upstreams": ["fabric"]
    },
    {
      "group": "^net[.]fabricmc[.]fabric-api$",
      "module": ".*",
      "license": "Apache-2.0",
      "evidence": "https://github.com/FabricMC/fabric-api/blob/HEAD/LICENSE",
      "upstreams": ["fabric"]
    },
    {
      "group": "^net[.]fabricmc$",
      "module": "^(intermediary|yarn)$",
      "license": "CC0-1.0",
      "evidence": "https://github.com/FabricMC/intermediary/blob/master/LICENSE",
      "upstreams": ["fabric"]
    },
    {
      "group": "^net[.]fabricmc$",
      "module": "^(access-widener|mapping-io|tiny-mappings-parser|stitch|dev-launch-injector|class-tweaker)$",
      "license": "Apache-2.0",
      "evidence": "https://github.com/FabricMC (LICENSE of access-widener, mapping-io, tiny-mappings-parser, stitch, dev-launch-injector, class-tweaker)",
      "upstreams": ["fabric"]
    },
    {
      "group": "^net[.]fabricmc$",
      "module": "^fabric-fernflower$",
      "license": "Apache-2.0",
      "evidence": "https://github.com/FabricMC/intellij-fernflower (JetBrains Fernflower, Apache-2.0 per-file headers)",
      "upstreams": ["fabric"]
    },
    {
      "group": "^net[.]fabricmc$",
      "module": "^(sponge-mixin|cfr|fabric-mixin-compile-extensions|lorenz-tiny|fabric-loom-native|fabric-loom)$",
